# Immich + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# IMMICH_SERVER_IMAGE_TAG=ghcr.io/immich-app/immich-server:v3.1.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.immich.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Immich
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname. Must resolve to this server's public IP for the
# Let's Encrypt TLS-ALPN challenge. REQUIRED.
IMMICH_HOSTNAME=immich.example.com

# REQUIRED — generate with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
# Immich asks for A-Za-z0-9 only here: the password is passed to the database
# through a connection string, and a special character in it is a parse error
# nobody wants to debug on first boot. The command above strips them for you.
IMMICH_DB_PASSWORD=change_me_before_first_start

# The first account registered becomes the administrator — open the site
# right after deploy and register it before anyone else can.

# Timezone used for date grouping and for EXIF timestamps without a zone.
# IMMICH_TZ=Etc/UTC

# Defaults below are set in the compose file; override only to diverge.
# IMMICH_DB_NAME=immich
# IMMICH_DB_USER=immichdbuser

# SSD or HDD. Selects which tuned postgresql.conf the database image loads.
# Set HDD only if the database volume is on spinning disk.
# IMMICH_DB_STORAGE_TYPE=SSD

# How long Traefik waits on a single request. A phone uploading a long video
# over a slow link is one request; the default 60s cuts it off mid-transfer.
# IMMICH_UPLOAD_TIMEOUT=600s

# Seconds an idle machine-learning model stays resident before it is unloaded.
# Worker-exit lines in the log after this interval are normal, not a crash.
# IMMICH_ML_MODEL_TTL=300

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# POSTGRES_BACKUP_PRUNE_DAYS=7
# DATA_BACKUP_PRUNE_DAYS=7
# POSTGRES_BACKUPS_PATH=/srv/immich-postgres/backups
# DATA_BACKUPS_PATH=/srv/immich-library/backups
# DATA_PATH=/data
# POSTGRES_BACKUP_NAME=immich-postgres-backup
# DATA_BACKUP_NAME=immich-library-backup

# What the library archive leaves out. thumbs and encoded-video are rebuilt
# from the originals by a job in the web UI and are usually larger than the
# originals themselves; backups/ holds Immich's own nightly dumps, which the
# backups container already takes properly. Set this to an empty string to
# archive everything.
# IMMICH_BACKUP_EXCLUDES=--exclude=thumbs --exclude=encoded-video --exclude=backups

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Immich asks for at least 6g of RAM across
# the stack, and at least 2g for the database alone where limits are in use.
# Sizing is per host: raise a limit if a service is OOM-killed
# (docker inspect shows OOMKilled=true).
# IMMICH_POSTGRES_MEMORY_LIMIT=2g
# IMMICH_POSTGRES_CPU_LIMIT=2.0
# IMMICH_POSTGRES_MEMORY_RESERVATION=256m
# IMMICH_POSTGRES_CPU_RESERVATION=0.25
# IMMICH_POSTGRES_SHM_SIZE=128mb
# IMMICH_REDIS_MEMORY_LIMIT=256m
# IMMICH_REDIS_CPU_LIMIT=0.5
# IMMICH_REDIS_MEMORY_RESERVATION=32m
# IMMICH_REDIS_CPU_RESERVATION=0.1
# IMMICH_MEMORY_LIMIT=3g
# IMMICH_CPU_LIMIT=2.0
# IMMICH_MEMORY_RESERVATION=256m
# IMMICH_CPU_RESERVATION=0.5
# IMMICH_ML_MEMORY_LIMIT=3g
# IMMICH_ML_CPU_LIMIT=2.0
# IMMICH_ML_MEMORY_RESERVATION=256m
# IMMICH_ML_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# IMMICH_BACKUPS_MEMORY_LIMIT=512m
# IMMICH_BACKUPS_CPU_LIMIT=1.0
# IMMICH_BACKUPS_MEMORY_RESERVATION=32m
# IMMICH_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits for a data-owning service to shut down before it
# sends SIGKILL. The default of ten seconds can cut short a PostgreSQL
# checkpoint or a Valkey save; sixty is the value this repository ships.
# Raise it if your library is large.
# IMMICH_POSTGRES_STOP_GRACE_PERIOD=60s
# IMMICH_REDIS_STOP_GRACE_PERIOD=60s

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# The server and the machine-learning image are one release: move both or
# neither. Immich supports no combination where they differ.
# TRAEFIK_IMAGE_VERSION=3.7
# IMMICH_POSTGRES_IMAGE_VERSION=14-vectorchord0.4.3-pgvectors0.2.0
# IMMICH_REDIS_IMAGE_VERSION=9
# IMMICH_SERVER_IMAGE_VERSION=v3.1.0
# IMMICH_ML_IMAGE_VERSION=v3.1.0
